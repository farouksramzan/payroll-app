# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Security — CHANGE BOTH IN PRODUCTION ─────────────────────────────────────
# JWT secret — use a random 64-char string in production
JWT_SECRET=payrolltaxpro_jwt_secret_change_this_in_production_64chars_minimum

# AES-256 encryption key — must be exactly 32 characters
ENCRYPTION_KEY=PayrollTaxPro_32CharKey_AES256!!

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev default: ../data/payroll.db (relative to backend/)
# Railway production: /data/payroll.db  (Railway Volume mounted at /data)
# DB_PATH=/data/payroll.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Leave unset when backend serves the frontend
# (same-origin requests need no CORS header).
# CORS_ORIGIN=https://your-app.up.railway.app

# ── EFTPS automation ─────────────────────────────────────────────────────────
# EFTPS_DRY_RUN=true  → stop before clicking Submit (safe default)
# EFTPS_DRY_RUN=false → live submission
EFTPS_DRY_RUN=true

# EFTPS_HEADLESS=true  → invisible browser (required in production / Railway)
# EFTPS_HEADLESS=false → visible browser window (local supervised testing only)
EFTPS_HEADLESS=true

# Directory where Playwright saves step screenshots (debug aid)
# SCREENSHOTS_DIR=/data/screenshots
