# TWC QuickFile Bridge — copy this to .env and fill in your values

# Railway backend URL (no trailing slash)
RAILWAY_URL=https://payroll-app-production-xxxx.up.railway.app

# Must match BRIDGE_TWC_SECRET set in Railway environment variables
BRIDGE_TWC_SECRET=your-secret-here

# Path to QuickFile executable on this machine
QUICKFILE_EXE=C:\Program Files (x86)\QuickFile\QuickFile.exe

# Path to AutoHotkey executable
AHK_EXE=C:\Program Files\AutoHotkey\AutoHotkey.exe

# Directory to store ICESA files temporarily during submission
TEMP_DIR=C:\TWC\temp
