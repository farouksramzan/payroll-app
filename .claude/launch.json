{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend"],
      "port": 5173
    },
    {
      "name": "dc-reply-copilot",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server \"${PORT:-4173}\" -d dc-reply-copilot"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "dc-outreach-radar",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 dc-outreach-radar/serve.py"],
      "port": 4174,
      "autoPort": true
    }
  ]
}
