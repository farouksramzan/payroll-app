# ── Railway connection ────────────────────────────────────────────────────────
# Full WebSocket URL of your Railway deployment, including the shared secret
# Format: wss://your-app.railway.app/ws/bridge
RAILWAY_WS_URL=wss://your-app.railway.app/ws/bridge

# Shared secret — must match BRIDGE_SECRET on the Railway server exactly
WEBSOCKET_SECRET=change_this_to_a_long_random_string

# ── EFTPS Batch Provider ──────────────────────────────────────────────────────
# Submission mode:
#   folder  (default) — drop ACH file into WATCHED_FOLDER_PATH, wait for response file
#   cli              — execute the Batch Provider exe directly
BATCH_PROVIDER_MODE=folder

# Full path to the Batch Provider executable (required when MODE=cli)
# Windows example: C:\EFTPS\EFTPSBatchProvider.exe
BATCH_PROVIDER_PATH=

# Command-line arguments prepended before the ACH file path (cli mode only)
BATCH_PROVIDER_ARGS=/import

# Folder where ACH files are written (Batch Provider watches this folder)
# Windows example: C:\EFTPS\Import
WATCHED_FOLDER_PATH=./data/ach-out

# Folder where Batch Provider writes response/acknowledgment files
# Windows example: C:\EFTPS\Response
RESPONSE_FOLDER_PATH=./data/ach-response

# How long to wait for a Batch Provider response before timing out (ms)
BATCH_RESPONSE_TIMEOUT_MS=120000

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the local dashboard at http://localhost:PORT
DASHBOARD_PORT=4000

# ── EFTPS Registration ───────────────────────────────────────────────────────
# Your EFTPS Batch Provider Registration ID (9-digit number shown in Batch Provider settings).
# This appears in field 1-9 of every payment record.
EFTPS_REGISTRATION_ID=890048906

# ── Anthropic Computer Use ────────────────────────────────────────────────────
# API key for Claude Sonnet computer use automation.
# When set, the bridge uses the Computer Use API to click through Batch Provider
# automatically. When unset, the bridge falls back to the folder/response mode.
ANTHROPIC_API_KEY=

# ── Batch Provider Master Credentials (for enrollment status checks) ──────────
# Master PIN shown in Batch Provider's security/login screen.
BATCH_PROVIDER_MASTER_PIN=

# Master Password used alongside the PIN.
BATCH_PROVIDER_MASTER_PASSWORD=

# Full path to tesseract.exe — used by bp_enrollment_check.py to OCR the
# enrollment list and confirm Active status.
# Example: C:\Users\mramz\OneDrive\Desktop\tesseract.exe
TESSERACT_PATH=C:\Users\mramz\OneDrive\Desktop\tesseract.exe

# ── Batch Provider screen coordinates ────────────────────────────────────────
# If BP's layout shifts (resolution/DPI/monitor change), update these instead
# of editing bp_automation.py. Defaults match a standard 1920×1080 setup.
BP_SEND_PAYMENTS_X=51
BP_SEND_PAYMENTS_Y=133
BP_IMPORT_X=386
BP_IMPORT_Y=966
BP_ADD_X=833
BP_ADD_Y=482
BP_OK1_X=1111
BP_OK1_Y=639
BP_OK2_X=798
BP_OK2_Y=629

# ── Incomplete payment recovery coordinates ───────────────────────────────────
# Used when BP reports "at least one payment requires an override / Incomplete status".
# Override button is found automatically via OCR (no coordinates needed).
BP_ENROLLMENTS_X=316
BP_ENROLLMENTS_Y=100
BP_ENROLLMENT_INQUIRY_X=165
BP_ENROLLMENT_INQUIRY_Y=129
BP_SYNC_X=1848
BP_SYNC_Y=964
BP_CANCEL_X=787
BP_CANCEL_Y=630
BP_EDIT_X=214
BP_EDIT_Y=963
BP_SAVE_X=1149
BP_SAVE_Y=753

# ── Advanced / optional ───────────────────────────────────────────────────────
# Milliseconds between reconnect attempts when the WebSocket drops
WS_RECONNECT_MS=10000
