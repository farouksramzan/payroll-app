# ── Railway connection ────────────────────────────────────────────────────────
# Full WebSocket URL of your Railway deployment, including the shared secret
# Format: wss://your-app.railway.app/ws/bridge
RAILWAY_WS_URL=wss://your-app.railway.app/ws/bridge

# Shared secret — must match BRIDGE_SECRET on the Railway server exactly
WEBSOCKET_SECRET=change_this_to_a_long_random_string

# ── EFTPS Batch Provider ──────────────────────────────────────────────────────
# Submission mode:
#   folder  (default) — drop ACH file into WATCHED_FOLDER_PATH, wait for response file
#   cli              — execute the Batch Provider exe directly
BATCH_PROVIDER_MODE=folder

# Full path to the Batch Provider executable (required when MODE=cli)
# Windows example: C:\EFTPS\EFTPSBatchProvider.exe
BATCH_PROVIDER_PATH=

# Command-line arguments prepended before the ACH file path (cli mode only)
BATCH_PROVIDER_ARGS=/import

# Folder where ACH files are written (Batch Provider watches this folder)
# Windows example: C:\EFTPS\Import
WATCHED_FOLDER_PATH=./data/ach-out

# Folder where Batch Provider writes response/acknowledgment files
# Windows example: C:\EFTPS\Response
RESPONSE_FOLDER_PATH=./data/ach-response

# How long to wait for a Batch Provider response before timing out (ms)
BATCH_RESPONSE_TIMEOUT_MS=120000

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the local dashboard at http://localhost:PORT
DASHBOARD_PORT=4000

# ── Advanced / optional ───────────────────────────────────────────────────────
# Federal Reserve / EFTPS operator routing number for the ACH File Header.
# If blank, the company's own bank routing is used (acceptable for most setups).
EFTPS_FED_ROUTING=

# Milliseconds between reconnect attempts when the WebSocket drops
WS_RECONNECT_MS=10000
